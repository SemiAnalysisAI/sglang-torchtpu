load("@rules_python//python:defs.bzl", "py_library")

package(default_visibility = ["//visibility:public"])

# Expose Python recipe configs to Bazel's hermetic Python interpreter.
py_library(
    name = "python_configs",
    srcs = glob(["recipe/**/*.py"]),
    imports = ["../.."],
)

# Shell launchers, evaluation configs, and helper programs in this directory,
# resolved at runtime by sglang.test.tpu. Executable bits are preserved in
# Bazel runfiles.
filegroup(
    name = "pkg",
    srcs = glob(["*"]),
)

# The whole benchmark/tpu tree, recipe subtree included, for callers that
# resolve files under either half at runtime.
alias(
    name = "recipe",
    actual = "//benchmark/tpu/recipe:pkg",
)
