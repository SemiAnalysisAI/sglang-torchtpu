load("@rules_python//python:defs.bzl", "py_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "include_data",
    srcs = glob(["include/**"]),
)

filegroup(
    name = "csrc_data",
    srcs = glob(["csrc/**"]),
)

py_library(
    name = "pkg",
    srcs = ["__init__.py"],
    imports = ["../../.."],
)

py_library(
    name = "__main__",
    srcs = ["__main__.py"],
    imports = ["../../.."],
    deps = [
        "//python/sglang/kernels/jit/utils:deps",
        "//python:cycle_0",
        "@sglang_pypi//apache_tvm_ffi",
    ],
)
