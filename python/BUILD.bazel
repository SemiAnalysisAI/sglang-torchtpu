"""Handwritten targets for the sglang Python package root.

The fine-grained module targets under ``python/sglang/**`` and the import-cycle
targets are machine-generated. The cycles are
emitted into ``cycles.bzl`` (loaded below) precisely so this BUILD file can
stay handwritten: the ``:sglang`` convenience aggregator belongs to humans, not
the generator, and must survive regeneration.
"""

load("@rules_python//python:defs.bzl", "py_library")
load(":cycles.bzl", "ALL_MODULE_DEPS", "declare_cycles")

package(default_visibility = ["//visibility:public"])

exports_files(["pyproject_tpu.toml"])

# One collapsed py_library per import cycle (cycle_0 .. cycle_N), gathered from
# the per-directory cycle_N_files filegroups the generator emits alongside the
# per-module targets.
declare_cycles()

# The dist metadata `pip install -e python` would register, generated from
# pyproject_tpu.toml so importlib.metadata (entry_points for platform plugins,
# version("sglang")) works for the in-tree package under runfiles.
genrule(
    name = "dist_info",
    srcs = ["pyproject_tpu.toml"],
    outs = [
        "sglang-0.0.0.dev0.dist-info/METADATA",
        "sglang-0.0.0.dev0.dist-info/entry_points.txt",
    ],
    cmd = "$(location :gen_dist_info) $(location pyproject_tpu.toml) $(@D)",
    tools = [":gen_dist_info"],
)

py_binary(
    name = "gen_dist_info",
    srcs = ["gen_dist_info.py"],
)

# Convenience aggregator: the whole sglang package. Tests and tools that want
# "all of sglang" depend on this rather than enumerating fine-grained targets.
# ALL_MODULE_DEPS is generated (cycle members -> their cycle_N target, every
# other module -> its own per-directory target), so it stays correct as modules
# and cycles change.
py_library(
    name = "sglang",
    data = [":dist_info"],
    deps = ALL_MODULE_DEPS,
)
