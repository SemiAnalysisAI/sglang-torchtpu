load("@rules_python//python:defs.bzl", "py_library")

package(default_visibility = ["//visibility:public"])

# Shared fixtures live outside test/registered, which CI scans for test entries.
py_library(
    name = "launcher_test_case",
    srcs = [
        "__init__.py",
        "launcher_test_case.py",
    ],
    data = ["//benchmark/tpu:launch_server"],
    deps = [
        "//benchmark/tpu:launcher",
        "//test:package",
    ],
)

py_library(
    name = "pd_singlehost_base",
    srcs = ["pd_singlehost_base.py"],
    deps = [
        ":launcher_test_case",
        "//benchmark/tpu:launcher",
    ],
)
